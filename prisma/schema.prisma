generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  username  String    @unique
  name      String?
  createdAt DateTime  @default(now())

  projects  Project[]
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String
  techStack   String[]

  userId      String
  user        User @relation(fields: [userId], references: [id])

  createdAt   DateTime @default(now())
}